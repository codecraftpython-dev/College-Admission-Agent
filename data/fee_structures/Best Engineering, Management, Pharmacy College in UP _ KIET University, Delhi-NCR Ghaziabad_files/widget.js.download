4px;\n            border-radius: 50%;\n            border: none;\n            background:rgba(${E(e?.theme?.mic_button?.color)?.r??"255"}, ${E(e?.theme?.mic_button?.color)?.g??"255"}, ${E(e?.theme?.mic_button?.color)?.b??"255"},${e?.theme?.mic_button?.background_opacity??"0.3"});\n            cursor: pointer;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            transition: all 0.2s ease;\n            margin-left: 12px;\n        }\n\n        .sbt-mute-btn:hover {\n            background: rgba(255, 255, 255, 0.2);\n            transform: scale(1.05);\n        }\n\n        .sbt-mute-btn svg {\n            width: 20px;\n            height: 20px;\n            fill: ${e?.theme?.mic_button?.icon_color||"white"}\n        }\n\n        .sbt-mute-btn.sbt-muted {\n           background: rgba(${E(e?.theme?.mic_button?.color)?.r??"255"}, ${E(e?.theme?.mic_button?.color)?.g??"255"}, ${E(e?.theme?.mic_button?.color)?.b??"255"},${e?.theme?.mic_button?.background_opacity??"0.3"});\n        }\n        \n\n        /* Empty State */\n        .sbt-empty-state {\n            flex: 1;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            justify-content: center;\n            color: rgba(255, 255, 255, 0.4);\n            font-size: 14px;\n            text-align: center;\n            padding: 20px;\n        }\n\n        .sbt-empty-state svg {\n            width: 48px;\n            height: 48px;\n            fill: rgba(255, 255, 255, 0.2);\n            margin-bottom: 12px;\n        }\n\n        /* Hidden audio element */\n        .sbt-remote-audio {\n            display: none;\n        }\n\n        /* Mobile Responsive */\n        @media (max-width: 480px) {\n            .sbt-chat-widget {\n                width: 100%;\n                height: 100%;\n                ${i}\n                border-radius: 0;\n            }\n\n            .sbt-widget-trigger-container {\n         