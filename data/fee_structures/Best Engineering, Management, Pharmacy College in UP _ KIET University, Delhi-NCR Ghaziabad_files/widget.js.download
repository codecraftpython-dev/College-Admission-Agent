height: 0;\n        }\n        \n        .sbt-text-transcript-area .sbt-empty-state {\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            justify-content: center;\n            height: 100%;\n            flex: 1;\n            color: #9ca3af;\n            gap: 12px;\n        }\n        \n        .sbt-text-transcript-area .sbt-empty-state svg {\n            width: 48px;\n            height: 48px;\n            fill: #d1d5db;\n        }\n        \n        .sbt-text-transcript-area .sbt-empty-state div {\n            font-size: 14px;\n        }\n        \n        /* Chat message styles */\n        .sbt-chat-message {\n            display: flex;\n            flex-direction:column-reverse;\n            \n            max-width: 85%;\n            animation: sbt-messageSlideIn 0.3s ease;\n        }\n        \n        @keyframes sbt-messageSlideIn {\n            from {\n                opacity: 0;\n                transform: translateY(10px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n        \n        .sbt-chat-message.sbt-user-message {\n            align-self: flex-end;\n            flex-direction: row-reverse;\n        }\n        \n        .sbt-chat-message.sbt-bot-message {\n            align-self: flex-start;\n        }\n        \n        .sbt-message-avatar {\n            width: 24px;\n            height: 24px;\n            border-radius: 50%;\n            flex-shrink: 0;\n            overflow: hidden;\n            margin-top:-18px;\n            margin-left:-12px;\n        }\n        \n        .sbt-message-avatar img {\n            width: 100%;\n            height: 100%;\n            object-fit: cover;\n        }\n\n        .sbt-message-avatar svg {\n            width: 100%;\n            height: 100%;\n            display: block;\n            background:${e?.chat_transfer?.agent_avatar_bg_color??"#e5e7eb"};\n            color:${e?.chat_transfer?.agent_avatar_color??"#000"};\n        }\n        \n        .sbt-message-content {\n            padding: 10px 14px;\n            border-radius: 16px;\n            font-size: 14px;\n            line-height: 1.4;\n        }\n        .sbt-message-content a{\n            color: ${e?.transcript_font_color??"#374151"};\n            text-decoration: underline;\n        }\n        \n        .sbt-user-message .sbt-message-content {\n            /* background: linear-gradient(135deg, ${n}, #8b5cf6); */\n            background: ${e?.user_bubble?.background_color_rgba??n};\n            color: ${e?.user_bubble?.font_color??"white"};\n            border-bottom-right-radius: 4px;\n            word-break: break-word;\n            overflow-wrap: break-word;\n            white-space: pre-wrap;\n        }\n        \n        .sbt-bot-message .sbt-message-content {\n            background: ${e?.transcript_background_color_rgba??"#f3f4f6"};\n            /* color: #374151; */\n            color:rgba(${E(e?.transcript_font_color)?.r??"0"}, ${E(e?.transcript_font_color)?.g??"0"}, ${E(e?.transcript_font_color)?.b??"0"} , 0.9);\n            border-bottom-left-radius: 4px;\n            word-break: break-word;\n            overflow-wrap: break-word;\n            white-space: pre-wrap;\n        }\n        \n        .sbt-message-time {\n            font-size: 11px;\n            color: #9ca3af;\n            /* color:${e?.transcript_background_color_rgba??"#9ca3af"}; */\n            margin-top: 4px;\n            margin-left:18px;\n        }\n        \n        .sbt-user-message .sbt-message-time {\n            text-align: right;\n        }\n        \n        /* Typing indicator */\n        .sbt-typing-indicator {\n            display: flex;\n            gap: 4px;\n            padding: 12px 16px;\n            background: ${e?.transcript_background_color_rgba??"#f3f4f6"};\n            border-radius: 16px;\n            border-bottom-left-radius: 4px;\n            width: fit-content;\n        }\n        \n        .sbt-typing-indicator span {\n            width: 8px;\n            height: 8px;\n            /*background: #9ca3af;*/\n            background:rgba(${E(e?.transcript_font_color)?.r??"0"}, ${E(e?.transcript_font_color)?.g??"0"}, ${E(e?.transcript_font_color)?.b??"0"} , 0.9);\n            border-radius: 50%;\n            animation: sbt-typingBounce 1.4s ease-in-out infinite;\n        }\n        \n        .sbt-typing-indicator span:nth-child(1) {\n            animation-delay: 0s;\n        }\n        \n        .sbt-typing-indicator span:nth-child(2) {\n            animation-delay: 0.2s;\n        }\n        \n        .sbt-typing-indicator span:nth-child(3) {\n            animation-delay: 0.4s;\n        }\n        \n        @keyframes sbt-typingBounce {\n            0%, 60%, 100% {\n                transform: translateY(0);\n            }\n            30% {\n                transform: translateY(-4px);\n            }\n        }\n                                /* ── Shared message body wrapper ── */\n.sbt-message-body { display: flex; flex-direction: column; gap: 2px; }\n\n/* ── Media blocks ── */\n.sbt-media-block  { padding: 0 !important; overflow: hidden; }\n.sbt-rich-image   { display: block; width: 100%; cursor: zoom-in; border-radius: inherit; }\n.sbt-rich-video   { display: block; width: 100%; max-width: 260px; border-radius: inherit; }\n.sbt-rich-audio   { width: 100%; min-width: 200px; height: 36px; }\n.sbt-media-caption { color:rgba(${E(e?.transcript_font_color)?.r??"0"}, ${E(e?.transcript_font_color)?.g??"0"}, ${E(e?.transcript_font_color)?.b??"0"} , 0.9); padding: 5px 10px 6px; }\n\n/* ── Document ── */\n.sbt-doc-block    { display: flex; align-items: center; gap: 10px; padding: 10px 12px !important; text-decoration: none; color: inherit; }\n.sbt-doc-block:hover { filter: brightness(0.97); }\n.sbt-doc-icon     { width: 30px; height: 30px; flex-shrink: 0; }\n.sbt-doc-meta     { flex: 1; min-width: 0; display: flex; flex-direction: column; }\n.sbt-doc-name     { font-size: 13px; font-weight: 600;  }\n.sbt-doc-size     { font-size: 11px; color: #999; }\n.sbt-doc-dl-icon  { width: 18px; height: 18px; fill: #4591ce; flex-shrink: 0; }\n\n/* ── Location ── */\n.sbt-location-block { display: block; text-decoration: none; color: inherit; overflow: hidden; }\n.sbt-location-thumb { height: 110px; background: #e8eaf6 center/cover no-repeat; display: flex; align-items: center; justify-content: center; }\n.sbt-location-thumb svg { width: 36px; height: 36px; fill: #e53935; filter: drop-shadow(0 2px 4px rgba(0,0,0,.3)); }\n.sbt-location-meta  { padding: 8px 12px; }\n.sbt-location-name  { display: block; font-size: 13px; font-weight: 600; }\n.sbt-location-addr  { display: block; font-size: 11px; color: #888; margin-top: 2px; }\n\n/* ── Buttons / List shared ── */\n.sbt-buttons-block,\n.sbt-list-block   { padding: 0 !important; display: flex; flex-direction: column; }\n.sbt-buttons-body { margin: 0; padding: 10px 13px; font-size: 14px; line-height: 1.5; }\n.sbt-btn-group    { border-top: 1px solid rgba(0,0,0,.08); display: flex; flex-direction: column; }\n.sbt-action-btn   {\n    display: block; padding: 10px 13px; text-align: center;\n    font-size: 14px; color: #007aff; background: none;\n    border: none; border-top: 1px solid rgba(0,0,0,.06);\n    cursor: pointer; text-decoration: none; transition: background .15s;\n}\n.sbt-action-btn:first-child    { border-top: none; }\n.sbt-action-btn:hover:not(:disabled) { background: rgba(0,122,255,.06); }\n.sbt-action-btn.sbt-btn-selected { font-weight: 700; color: #007aff; }\n.sbt-action-btn.sbt-btn-used     { opacity: .45; cursor: not-allowed; }\n\n/* ── List ── */\n.sbt-list-header        { padding: 10px 13px; font-weight: 700; font-size: 14px; border-bottom: 1px solid rgba(0,0,0,.08); }\n.sbt-list-section-title { padding: 5px 13px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; color: #999; background: rgba(0,0,0,.03); }\n.sbt-list-item {\n    display: flex; align-items: center; justify-content: space-between;\n    width: 100%; padding: 10px 13px; background: none; border: none;\n    border-top: 1px solid rgba(0,0,0,.06); text-align: left; cursor: pointer; transition: background .15s;\n}\n.sbt-list-item:hover:not(:disabled) { background: rgba(0,0,0,.03); }\n.sbt-list-item.sbt-btn-selected { background: rgba(0,122,255,.08); }\n.sbt-list-item.sbt-btn-used     { opacity: .5; cursor: not-allowed; }\n.sbt-list-item-title { font-size: 14px; font-weight: 500; }\n.sbt-list-item-desc  { font-size: 12px; color: #888; margin-top: 2px; }\n.sbt-list-item > svg { width: 18px; height: 18px; fill: #ccc; flex-shrink: 0; }\n\n/* ── Quick replies ── */\n.sbt-quick-replies { display: flex; flex-wrap: wrap; gap: 6px; padding: 4px 12px 10px; }\n.sbt-qr-chip {\n    background: ${e?.quick_reply_button?.bg??"#fff"};\n    border: 1.5px solid ${e?.quick_reply_button?.border_color??"#007aff"};\n    color: ${e?.quick_reply_button?.font_color??"#007aff"};\n    border-radius: 20px;\n    padding: 6px 14px;\n    font-size: 13px;\n    cursor: pointer; \n    transition: background .15s, color .15s;\n}\n.sbt-qr-chip:hover:not(:disabled) { background: ${e?.quick_reply_button?.hover_bg??"#007aff"}; color: ${e?.quick_reply_button?.hover_font_color??"#fff"}; }\n.sbt-qr-chip.sbt-btn-selected     { background: ${e?.quick_reply_button?.hover_bg??"#007aff"}; color: ${e?.quick_reply_button?.hover_font_color??"#fff"}; }\n.sbt-qr-chip.sbt-btn-used         { opacity: .45; cursor: not-allowed; }\n\n\n/* ── Lightbox ── */\n.sbt-lightbox { position: fixed; inset: 0; background: rgba(0,0,0,.88); display: flex; align-items: center; justify-content: center; z-index: 99999; }\n.sbt-lightbox-media { max-width: 90vw; max-height: 90vh; border-radius: 8px; }\n.sbt-lightbox-close { position: absolute; top: 16px; right: 16px; width: 36px; height: 36px; border-radius: 50%; background: rgba(255,255,255,.15); border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; }\n.sbt-lightbox-close svg { width: 20px; height: 20px; fill: #fff; }\n\n\n/* ── vLite video ── */\n.sbt-video-block      { padding: 0 !important; }\n.sbt-vlite-wrap       { width: 100%; }\n.sbt-vlite-wrap .vlite-js { border-radius: inherit; }\n\n/* override vLite accent color to match your theme */\n.sbt-vlite-wrap .v-progressBar { background: var(--sbt-accent, #007aff) !important; }\n.sbt-vlite-wrap .v-bigPlayButton svg { fill: #fff; }\n/* hide loading spinner once controls are present */\n.sbt-vlite-wrap .v-loader {\n    display: none !important;\n}\n\n/* hide the dot artifacts — those are the v-loading overlay */\n.sbt-vlite-wrap .v-loading .v-loader {\n    display: none !important;\n}\n\n/* ensure poster shows while paused */\n.sbt-vlite-wrap .v-vlite.v-firstStart video {\n    object-fit: cover;\n}\n\n/* ── Splide carousel ── */\n.sbt-carousel-outer   { padding: 4px 0 8px; }\n.sbt-carousel-meta    { display: flex; align-items: center; gap: 8px; padding: 0 12px 4px; }\n\n.sbt-splide           { padding: 4px 0 8px; }\n.sbt-splide-card      {\n    border-radius: 12px;\n    overflow: hidden;\n    background: ${e?.transcript_background_color_rgba??"#f3f4f6"};\n    color:rgba(${E(e?.transcript_font_color)?.r??"0"}, ${E(e?.transcript_font_color)?.g??"0"}, ${E(e?.transcript_font_color)?.b??"0"} , 0.9);\n    border: 1px solid rgba(0,0,0,0.1);\n    display: flex;\n    flex-direction: column;\n    height: auto;\n}\n.sbt-card-img         { width: 100%; height: 130px; object-fit: cover; display: block; }\n.sbt-card-body        { padding: 10px 12px; flex: 1; }\n.sbt-card-title {\n    /* background: ${e?.transcript_background_color_rgba??"#f3f4f6"}; */\n    /* color: #374151; */\n    color:rgba(${E(e?.transcript_font_color)?.r??"0"}, ${E(e?.transcript_font_color)?.g??"0"}, ${E(e?.transcript_font_color)?.b??"0"} , 0.9);\n    border-bottom-left-radius: 4px;\n    word-break: break-word;\n    overflow-wrap: break-word;\n    white-space: pre-wrap;\n    font-size:14px;\n} \n.sbt-card-subtitle    { font-size: 12px; color: #777; margin-top: 3px; }\n.sbt-card-btn-group   { border-top: 1px solid rgba(0,0,0,0.08); }\n.sbt-card-btn         { font-size: 13px; padding: 9px; }\n\n/* Splide arrows — restyle to match widget */\n.sbt-splide .splide__arrow {\n    background: #fff;\n    box-shadow: 0 2px 8px rgba(0,0,0,0.15);\n    opacity: 1;\n    width: 28px;\n    height: 28px;\n}\n.sbt-splide .splide__arrow svg { fill: #555; width: 14px; height: 14px; }\n.sbt-splide .splide__arrow:hover { background: var(--sbt-accent, #007aff); }\n.sbt-splide .splide__arrow:hover svg { fill: #fff; }\n\n/* ══════════════════════════════════════════\n   BANNER — embossed card style\n══════════════════════════════════════════ */\n.sbt-banner-block {\n    padding: 0 !important;\n    overflow: hidden;\n    display: flex;\n    flex-direction: column;\n}\n\n/* ── Media wrap — full bleed, no padding ── */\n.sbt-banner-media-wrap {\n    position: relative;\n    overflow: hidden;\n    border-radius: 2px 14px 0 0;    /* match top of card */\n    flex-shrink: 0;\n    \n    padding:6px;\n}\n\n.sbt-banner-image {\n    /*display: block;\n    width: 100%;\n    height: 180px;\n    object-fit: cover;*/\n    cursor: zoom-in;\n    transition: transform 0.3s ease; \n    width: 100%;\n  height: auto;\n  display: block;\n  object-fit: cover;\n  max-width: 25.75rem;\n  aspect-ratio: 1269/645;\n  object-position: top center;\n  border-radius: 0.5rem 0.5rem 0px 0px;\n}\n.sbt-banner-image:hover {\n    transform: scale(1.02);\n}\n\n/* caption overlaid on image bottom */\n.sbt-banner-img-caption {\n    position: absolute;\n    bottom: 0;\n    left: 0;\n    right: 0;\n    padding: 20px 12px 8px;\n    font-size: 11px;\n    color: #fff;\n    background: linear-gradient(transparent, rgba(0,0,0,0.55));\n    pointer-events: none;\n}\n\n/* vLitejs inside banner */\n.sbt-banner-vlite {\n    border-radius: 10px 10px 0 0;\n    overflow: hidden;\n}\n.sbt-banner-vlite .v-vlite {\n    width: 100% !important;\n    aspect-ratio: 16 / 9;\n    border-radius: 0;\n}\n.sbt-banner-vlite .v-progressBar {\n    color: var(--sbt-accent, #007aff) !important;\n}\n\n/* ── Content area ── */\n.sbt-banner-content {\n    padding: 12px 14px 14px;\n    display: flex;\n    flex-direction: column;\n    gap: 5px;\n    /* subtle top separator — engraved line */\n    border-top: 1px solid rgba(0,0,0,0.06);\n}\n\n.sbt-banner-title {\n    font-size: 14px;\n    font-weight: 700;\n    color: #111;\n    line-height: 1.35;\n    letter-spacing: -0.1px;\n}\n\n.sbt-banner-body {\n    \n    color:rgba(${E(e?.transcript_font_color)?.r??"0"}, ${E(e?.transcript_font_color)?.g??"0"}, ${E(e?.transcript_font_color)?.b??"0"} , 0.9);\n    line-height: 1.6;\n    margin: 0;\n}\n\n/* ── Buttons ── */\n.sbt-banner-btn-group {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 6px;\n    margin-top: 6px;\n}\n\n.sbt-banner-btn {\n    padding: 7px 15px;\n    border-radius: 8px;\n    font-size: 12.5px;\n    font-weight: 700;\n    cursor: pointer;\n    text-decoration: none;\n    display: inline-block;\n    transition: all 0.15s;\n    border: none;\n\n    /* embossed button */\n    background: var(--sbt-accent, #007aff);\n    color: #fff;\n    box-shadow:\n        0 1px 0 0 rgba(255,255,255,0.25) inset,\n        0 2px 4px rgba(0,122,255,0.35),\n        0 1px 2px rgba(0,0,0,0.15);\n}\n.sbt-banner-btn:hover:not(:disabled) {\n    transform: translateY(-1px);\n    box-shadow:\n        0 1px 0 0 rgba(255,255,255,0.25) inset,\n        0 4px 8px rgba(0,122,255,0.4),\n        0 2px 4px rgba(0,0,0,0.15);\n}\n.sbt-banner-btn:active:not(:disabled) {\n    transform: translateY(0px);\n    box-shadow:\n        0 1px 2px rgba(0,0,0,0.2) inset,\n        0 1px 2px rgba(0,122,255,0.2);\n}\n.sbt-banner-btn.sbt-btn-selected {\n    background: #005ec4;\n    box-shadow: 0 1px 2px rgba(0,0,0,0.2) inset;\n}\n.sbt-banner-btn.sbt-btn-used {\n    opacity: 0.45;\n    cursor: not-allowed;\n    transform: none;\n}\n\n/* ── Document inside banner ── */\n.sbt-banner-doc {\n    border-radius: 0 !important;\n    border: none !important;\n    border-top: 1px solid rgba(0,0,0,0.07) !important;\n    background: #fafafa;\n}\n\n\n/* ── Document download button ── */\n        .sbt-doc-dl-btn {\n            background: none;\n            border: none;\n            padding: 4px;\n            cursor: pointer;\n            flex-shrink: 0;\n            border-radius: 6px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            transition: background 0.15s;\n        }\n        .sbt-doc-dl-btn:hover {\n            background: rgba(0, 0, 0, 0.06);\n        }\n        .sbt-doc-dl-icon {\n            width: 18px;\n            height: 18px;\n            /* fill: var(--sbt-accent, #007aff); */\n            fill : rgba(${E(e?.transcript_font_color)?.r??"0"}, ${E(e?.transcript_font_color)?.g??"0"}, ${E(e?.transcript_font_color)?.b??"0"} , 0.5);\n        }\n        .sbt-doc-dl-loading .sbt-doc-dl-icon {\n            animation: sbt-spin 0.8s linear infinite;\n            /* fill: var(--muted, #999); */\n            fill : rgba(${E(e?.transcript_font_color)?.r??"0"}, ${E(e?.transcript_font_color)?.g??"0"}, ${E(e?.transcript_font_color)?.b??"0"} , 0.3);\n        }\n            .sbt-doc-caption {\n                font-size: 11px;\n                color:rgba(${E(e?.transcript_font_color)?.r??"0"}, ${E(e?.transcript_font_color)?.g??"0"}, ${E(e?.transcript_font_color)?.b??"0"} , 0.9);\n                margin-top: 2px;\n                \n            }\n        @keyframes sbt-spin {\n            to { transform: rotate(360deg); }\n        }\n\n        .sbt-agent-heading {\n            text-align: center;\n            margin: 16px 0;\n            position: relative;\n        }\n\n        .sbt-agent-heading-text {\n            display: inline-block;\n            padding: 4px 12px;\n            /*background: #e5e7eb;*/\n            background: ${e?.chat_transfer?.agent_alert_bg_color??"#e5e7eb"};\n            border-radius: 12px;\n            font-size: 12px;\n            font-weight: 500;\n            color: ${e?.chat_transfer?.agent_alert_font_color??"#4b5563"};\n        }\n\n        .sbt-agent-heading-time {\n            font-size: 10px;\n            color: #9ca3af;\n            margin-top: 2px;\n        }\n\n\n    `,C.appendChild(o)}();const Y=document.createElement("div");Y.className="sbt-widget-footer",A&&(Y.style.display="none");const X=document.createElement("button");X.className="sbt-end-call-btn sbt-hidden",X.innerHTML='\n        <svg viewBox="0 0 24 24">\n            <path d="M12 9c-1.6 0-3.15.25-4.6.72v3.1c0 .39-.23.74-.56.9-.98.49-1.87 1.12-2.66 1.85-.18.18-.43.28-.7.28-.28 0-.53-.11-.71-.29L.29 13.08c-.18-.17-.29-.42-.29-.7 0-.28.11-.53.29-.71C3.34 8.78 7.46 7 12 7s8.66 1.78 11.71 4.67c.18.18.29.43.29.71 0 .28-.11.53-.29.71l-2.48 2.48c-.18.18-.43.29-.71.29-.27 0-.52-.11-.7-.28-.79-.74-1.69-1.36-2.67-1.85-.33-.16-.56-.5-.56-.9v-3.1C15.15 9.25 13.6 9 12 9z"/>\n        </svg>\n    ',X.addEventListener("click",rt),Y.appendChild(X);const G=document.createElement("button");G.className="sbt-mute-btn",G.classList.add("sbt-hidden"),G.innerHTML='\n        <svg class="sbt-mic-icon" viewBox="0 0 24 24">\n            <path d="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3zm-1-9c0-.55.45-1 1-1s1 .45 1 1v6c0 .55-.45 1-1 1s-1-.45-1-1V5zm6 6c0 2.76-2.24 5-5 5s-5-2.24-5-5H5c0 3.53 2.61 6.43 6 6.92V21h2v-3.08c3.39-.49 6-3.39 6-6.92h-2z"/>\n        </svg>\n        <svg class="sbt-mic-off-icon" style="display:none" viewBox="0 0 24 24">\n            <path d="M19 11h-1.7c0 .74-.16 1.43-.43 2.05l1.23 1.23c.56-.98.9-2.09.9-3.28zm-4.02.17c0-.06.02-.11.02-.17V5c0-1.66-1.34-3-3-3S9 3.34 9 5v.18l5.98 5.99zM4.27 3L3 4.27l6.01 6.01V11c0 1.66 1.33 3 2.99 3 .22 0 .44-.03.65-.08l1.66 1.66c-.71.33-1.5.52-2.31.52-2.76 0-5.3-2.1-5.3-5.1H5c0 3.41 2.72 6.23 6 6.72V21h2v-3.28c.91-.13 1.77-.45 2.54-.9L