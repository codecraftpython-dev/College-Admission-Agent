-form::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }\n\n        .sbt-lead-form-dynamic {\n            display: flex;\n            flex-direction: column;\n            gap: 12px;\n        }\n\n\n    /* 🔹 Separate Welcome Card */\n    .sbt-welcome-greeting {\n        background: rgba(255,255,255,0.95);\n        border-radius: 14px;\n        padding: 18px 16px;\n        box-shadow: 0 4px 20px rgba(0,0,0,0.12);\n    }\n\n    \n\n    /* 🔹 Form Card (Already Separate) */\n    .sbt-lead-card {\n        background: rgba(255,255,255,0.95);\n        border-radius: 14px;\n        padding: 16px;\n        box-shadow: 0 4px 20px rgba(0,0,0,0.12);\n        display: flex;\n        flex-direction: column;\n        gap: 12px;\n    }\n        .sbt-welcome-container {\n            flex: 1;\n            overflow-y: auto;\n           /* padding: 5px 11px; */\n            display: flex;\n            flex-direction: column;\n            gap: 14px;\n             justify-content: center;\n              align-items: center;\n            transition: opacity 0.25s ease, transform 0.25s ease;\n        }\n\n       \n\n  transition: opacity 0.25s ease, transform 0.25s ease;\n        .sbt-welcome-greeting {\n            padding: 0 4px;\n        }\n\n        .sbt-welcome-hi {\n            font-family:${i.heading_font};\n            font-size: ${i.heading_size}px;\n            font-weight: 700;\n            color: ${i.heading_color};\n            margin: 0 0 6px 0;\n            text-align:center;\n        }\n\n        /* Info card */\n        .sbt-info-card {\n            background: rgba(255,255,255,0.95);\n            border-radius: 14px;\n            padding: 18px 16px;\n            text-align: center;\n            box-shadow: 0 4px 20px rgba(0,0,0,0.12);\n        }\n\n        .sbt-info-card-icon {\n            font-size: 22px;\n            margin-bottom: 8px;\n            background: linear-gradient(135deg, ${t}, ${e});\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            font-weight: 900;\n            letter-spacing: -2px;\n        }\n\n        .sbt-info-card-title {\n            font-size: 15px;\n            font-weight: 700;\n            color: #111827;\n            margin-bottom: 6px;\n        }\n\n        .sbt-info-card-desc {\n            font-size: 12px;\n            color: #6b7280;\n            line-height: 1.5;\n        }\n\n        /* Lead form card */\n\n        \n        .sbt-lead-card {\n            background: rgba(255,255,255,0.95);\n            border-radius: 14px;\n            padding: 16px;\n            box-shadow: 0 4px 20px rgba(0,0,0,0.12);\n            display: flex;\n            flex-direction: column;\n            gap: 10px;\n        }\n\n        .sbt-lead-card-label {\n            font-size: 13px;\n            color: #374151;\n            font-weight: 500;\n            margin: 0 0 2px 0;\n        }\n\n        .sbt-welcome-field {\n            width: 100%;\n        }\n\n        .sbt-welcome-input {\n            font-family:${i?.input_font||"inherit"} !important;\n            width: 100% !important;\n            height:auto !important;\n            box-sizing: border-box !important;\n            border: 1.5px solid ${i?.input_border_color??"#e5e7eb"} !important;\n            border-radius: ${i?.input_border_radius??"10"}px !important;\n            padding: 10px 14px !important;\n            font-size: ${i?.input_font_size??"13"}px !important;\n            color: ${i?.input_text_color??"#111827"} !important;\n            outline: none !important;\n            transition: border-color 0.2s ease, box-shadow 0.2s ease !important;\n            background: ${i?.input_bg_rgba??"#f9fafb"} !important;\n        }\n\n        \n\n        .sbt-welcome-input::placeholder {\n            color: ${i?.input_text_color??"#3333"};\n            font-weight: 300;\n            opacity: 0.4;\n        }\n\n        /* ===== Action buttons ===== */\n        .sbt-welcome-actions {\n            display: flex;\n            flex-direction: column;\n            gap: 10px;\n        }\n\n        .sbt-welcome-submit {\n            width: 100%;\n            padding: 10px 14px;\n            border: none;\n            border-radius: 14px;\n            font-size: 14px;\n            font-weight: 500;\n            cursor: pointer;\n            display: inline-flex;\n            align-items: center;\n            justify-content: center;\n            gap: 10px;\n            transition: transform 0.15s ease, box-shadow 0.2s ease, opacity 0.2s ease;\n            position: relative;\n        }\n        .sbt-welcome-submit:hover { transform: translateY(-1px); }\n        .sbt-welcome-submit:active { transform: scale(0.985); }\n        .sbt-btn-label { white-space: nowrap; }\n\n        /* Primary voice button */\n        .sbt-welcome-submit-voice {\n            font-family: ${i?.btn_font_voice||"inherit"} !important;\n            background: linear-gradient(135deg, ${a}, ${a});\n            color: ${i?.btn_text_color_voice??"#ffffff"};\n            \n        }\n        \n        .sbt-btn-icon-circle {\n            width: 26px;\n            height: 26px;\n            border-radius: 50%;\n            background:rgba(${E(i?.btn_text_color_voice)?.r??"255"}, ${E(i?.btn_text_color_voice)?.g??"255"}, ${E(i?.btn_text_color_voice)?.b??"255"} , 0.22);\n            display: inline-flex;\n            align-items: center;\n            justify-content: center;\n            flex-shrink: 0;\n            color: ${i?.btn_text_color_voice??"#ffffff"};\n        }\n        \n        .sbt-btn-arrow {\n            opacity: 0.9;\n            transition: transform 0.2s ease;\n        }\n        .sbt-welcome-submit-voice:hover .sbt-btn-arrow {\n            transform: translateX(3px);\n        }\n\n        /* Secondary text button (ghost) */\n        .sbt-welcome-submit-text {\n            font-family: ${i?.btn_font_text||"inherit"} !important;\n            background: ${i?.btn_primary_color_